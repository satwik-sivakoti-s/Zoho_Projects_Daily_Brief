# Zoho OAuth (https://api-console.zoho.in) — create a Self Client / Server-based app
# Required scopes:
#   ZohoProjects.portals.READ,ZohoProjects.projects.READ,ZohoProjects.tasks.READ
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_PROJECTS_DOMAIN=https://projectsapi.zoho.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Optional — leave blank to auto-pick the default portal
ZOHO_PORTAL_ID=

# Flock incoming webhook URL
# Create via Flock Admin → Integrations → Incoming Webhooks
FLOCK_WEBHOOK_URL=https://api.flock.com/hooks/sendMessage/YOUR_TOKEN

# REQUIRED on Vercel — Supabase Cron (and manual curls) send Authorization: Bearer <value>
# Must match the Vault secret zoho_projects_cron_secret in Supabase "Internal Tools"
# Generate a random 16+ character string
ZOHO_PROJECTS_CRON_SECRET=

# Every run calls Zoho with status=all (open + closed) for accurate counts.
# Set true to also show completed tasks in the bullet list (default: counts only).
SHOW_COMPLETED_IN_LIST=false

# India portals usually use DMY; US portals may need MDY
DEADLINE_DATE_ORDER=DMY

# Timezone used in the message header + Delayed/On Track calculation
BRIEF_TIMEZONE=Asia/Kolkata

# Hide tasks whose deadline is this many days or more away (default 7). Set 0 to show all.
HIDE_IF_DEADLINE_DAYS_AHEAD=7

# Extra weekend guard (Supabase cron already runs Mon–Fri only)
SKIP_WEEKENDS=true
